// Prisma Schema for SSISM College Asset & Inventory Management System (MongoDB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  STAFF
  HIGHER_MANAGEMENT
  SUPER_ADMIN
}

enum AcquisitionSource {
  PURCHASED
  DONATED
}

enum AssetCategory {
  LAPTOP
  WHITEBOARD_PANEL
  SMART_TV
  ROUTER
  AIR_FIBER
  PRINTER
  MONITOR
  CCTV
  INTERACTIVE_WHITEBOARD
  PERIPHERAL
  OTHER
}

enum AssetCondition {
  BRAND_NEW
  GOOD
  SCRATCHES
  DAMAGED
}

enum AssetStatus {
  AVAILABLE
  ISSUED
  UNDER_MAINTENANCE
  RETIRED
}

enum AllocationStatus {
  ACTIVE
  RETURNED
}

enum MaintenanceType {
  RAM_UPGRADE
  SSD_UPGRADE
  BATTERY_REPLACEMENT
  SCREEN_REPAIR
  KEYBOARD_REPAIR
  GENERAL_SERVICE
  OS_INSTALLATION
  OTHER
}

enum FeeStatus {
  PAID
  UNPAID
  PARTIAL
  EXEMPTED
}

enum AuditVerificationStatus {
  PHYSICAL_OK
  NEEDS_REPAIR
  MISSING
}

/// Dynamic Master Asset Categories for Phase 2 scaling (e.g., Laptop, Router, CCTV, Smart TV)
model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Corporate, NGO, and Alumni Donors contributing laptops and educational assets
model Donor {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String    // Contact person / Representative
  organization String?   // Corporate / NGO / Alumni entity
  email        String?
  phone        String?
  address      String?
  donationDate DateTime? @default(now())
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assets       Asset[]
}

/// College Academic & Administrative Departments (e.g., Computer Science, IT, MBA, Mechanical)
model Department {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  name       String    @unique
  code       String    @unique
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  users  User[]
  assets Asset[]

  @@index([isArchived])
}

/// Users of SSISM IMS spanning 5 RBAC tiers: SUPER_ADMIN, STAFF, HIGHER_MANAGEMENT, FACULTY, STUDENT
model User {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  email              String      @unique
  passwordHash       String
  name               String
  rollNumberOrEmpId  String      @unique
  role               Role        @default(STUDENT)
  departmentId       String?     @db.ObjectId
  department         Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  batchYear          String?     // e.g. "2023-2027" for students
  phone              String?
  fatherName         String?     // Student Father's Name
  branch             String?     // e.g. "ITEG", "MEG", "B.Tech CSE"
  track              String?     // e.g. "Full Stack", "Data Science"
  aadhaarNumber      String?     @unique
  address            String?
  designation        String?     // Staff/Faculty current role or designation
  isArchived         Boolean     @default(false)
  archivedAt         DateTime?
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Allocations received by this user
  receivedAllocations Allocation[] @relation("RecipientAllocations")

  // Allocations issued or accepted by this staff/admin
  issuedAllocations   Allocation[] @relation("IssuerAllocations")
  returnedAllocations Allocation[] @relation("ReturnReceiverAllocations")

  // Maintenance activities performed/handled
  maintenanceLogs     MaintenanceLog[]

  // Student license fee records
  licenseFeeRecords   LicenseFeeRecord[]

  // Audit activities triggered by this user
  auditLogs           AuditLog[]

  // Physical Verification relations
  verifiedAssets          Asset[]            @relation("AssetVerifier")
  conductedPhysicalAudits PhysicalAuditLog[] @relation("PhysicalAuditsConducted")

  // AirFiber / Router recharges logged by this staff/admin
  loggedRecharges         RechargeHistory[]  @relation("RechargesLogged")

  @@index([role])
  @@index([departmentId])
  @@index([isArchived])
}

/// Core Hardware Asset Catalog (Laptops & Phase 2 extensible equipment via native JSON attributes)
model Asset {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  assetTag          String            @unique // e.g., "LP/2025/001" or "CLG-LAP-001"
  serialNumber      String            @unique // e.g., "SN-DELL-83921"
  category          AssetCategory     @default(LAPTOP)
  make              String            // e.g., "Dell", "Lenovo", "HP", "Apple"
  model             String            // e.g., "Latitude 3420", "ThinkPad E14"
  
  // Hardware specifications (Relational for indexed searching)
  processor         String?           // e.g., "Intel Core i5-1135G7"
  generation        String?           // e.g., "11th Gen", "12th Gen", "M2"
  ram               String?           // e.g., "16GB DDR4"
  storage           String?           // e.g., "512GB NVMe SSD"
  displaySize       String?           // e.g., "14 inch", "15.6 inch"
  color             String?           // e.g., "Space Gray", "Silver", "Black"

  // Accessories Checklist
  chargerSerial     String?
  hasBag            Boolean           @default(true)
  hasMouse          Boolean           @default(false)

  // Acquisition Source & Donor Association
  acquisitionSource AcquisitionSource @default(PURCHASED)
  donorId           String?           @db.ObjectId
  donor             Donor?            @relation(fields: [donorId], references: [id], onDelete: SetNull)

  // Procurement & Warranty
  purchaseDate      DateTime?
  invoiceNo         String?
  warrantyExpiry    DateTime?
  
  // Current Lifecycle Status
  condition         AssetCondition    @default(BRAND_NEW)
  status            AssetStatus       @default(AVAILABLE)
  remarks           String?

  // Location / Assigned Department (Optional default base location)
  departmentId      String?           @db.ObjectId
  department        Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Native JSON for Dynamic Attributes
  attributes        Json?

  isArchived        Boolean           @default(false)
  archivedAt        DateTime?

  // Physical Verification & Audit Tracking
  lastVerifiedAt      DateTime?
  verifiedById        String?                  @db.ObjectId
  verifiedBy          User?                    @relation("AssetVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  auditStatus         AuditVerificationStatus? @default(PHYSICAL_OK)
  verificationRemarks String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relational Histories
  allocations       Allocation[]
  maintenanceLogs   MaintenanceLog[]
  physicalAudits    PhysicalAuditLog[]
  rechargeHistory   RechargeHistory[]

  // Category-specific metadata fields
  modelNumber       String?           // General: OEM / Model number
  location          String?           // Room/Lab/Office e.g. "Room 204", "Lab 2", "Seminar Hall"

  // AirFiber / Routers Specific
  simNumber         String?           // SIM card identifier / ICCID
  serviceProvider   String?           // e.g., "JIO", "AIRTEL", "OTHER", "BSNL", "VI"
  planDetails       String?           // e.g., "100 Mbps Unlimited Annual Plan"
  lastRechargeDate  DateTime?
  rechargeExpiryDate DateTime?
  monthlyCost       Float?

  // Printers / Monitors / Panels Specific
  ipAddress         String?           // Network IP address for Printers/Smart Devices
  screenSize        String?           // Screen Size e.g., "65 inch", "75 inch", "27 inch"
  inkCartridgeType  String?           // Cartridge / Toner model e.g., "HP 88A", "Canon 057"

  @@index([status])
  @@index([category])
  @@index([condition])
  @@index([make])
  @@index([departmentId])
  @@index([location])
  @@index([acquisitionSource])
  @@index([donorId])
  @@index([isArchived])
  @@index([lastVerifiedAt])
  @@index([auditStatus])
  @@index([rechargeExpiryDate])
}

/// Immutable Hardware Allocation Ledger tracking distribution to Students & Faculty
model Allocation {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  assetId         String           @db.ObjectId
  asset           Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  
  recipientId     String           @db.ObjectId
  recipient       User             @relation("RecipientAllocations", fields: [recipientId], references: [id], onDelete: Restrict)
  
  issuedById      String           @db.ObjectId
  issuedBy        User             @relation("IssuerAllocations", fields: [issuedById], references: [id], onDelete: Restrict)
  
  issuedAt        DateTime         @default(now())
  dueDate         DateTime?
  expectedReturnDate DateTime?
  
  returnedAt      DateTime?
  returnedById    String?          @db.ObjectId
  returnedBy      User?            @relation("ReturnReceiverAllocations", fields: [returnedById], references: [id], onDelete: SetNull)
  
  issueCondition  AssetCondition   @default(GOOD)
  returnCondition AssetCondition?
  
  fineAmount      Float?           @default(0)
  fineReason      String?
  finePaid        Boolean?         @default(false)
  finePaymentMode String?          // CASH, UPI, BANK_TRANSFER, PENDING
  
  status          AllocationStatus @default(ACTIVE)
  accessories     Json?            // Array of issued accessories, e.g. ["Charger / Adapter", "Laptop Bag", "External Mouse"]
  notes           String?
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([assetId])
  @@index([recipientId])
  @@index([status])
  @@index([expectedReturnDate])
}

/// Hardware Service, Component Replacement & Upgrade History
model MaintenanceLog {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  assetId            String          @db.ObjectId
  asset              Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  performedById      String?         @db.ObjectId
  performedBy        User?           @relation(fields: [performedById], references: [id], onDelete: SetNull)
  
  type               MaintenanceType @default(GENERAL_SERVICE)
  cost               Float?
  vendorOrTechnician String?
  description        String
  performedAt        DateTime        @default(now())
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([assetId])
  @@index([type])
}

/// Annual Student Software License Fee Records and Clearance Ledger
model LicenseFeeRecord {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId    String    @db.ObjectId
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  academicYear String    // e.g. "2025-2026"
  semester     String?   // e.g. "Semester 3"
  amount       Float
  status       FeeStatus @default(UNPAID)
  paymentDate  DateTime?
  receiptNo    String?
  notes        String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([studentId, academicYear])
  @@index([status])
  @@index([academicYear])
}

/// System-Wide Security Audit Trail and Operational Activity Log
model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String?  @db.ObjectId
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  
  action     String   // e.g. "ASSET_CREATED", "ALLOCATION_ISSUED", "ASSET_RETURNED"
  entityType String   // e.g. "Asset", "Allocation", "User"
  entityId   String
  details    Json?    // Snapshot of changes / payload
  ipAddress  String?
  
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

/// Physical Audit & Periodic Verification Ledger for Hardware Custody
model PhysicalAuditLog {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  assetId      String                  @db.ObjectId
  asset        Asset                   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  verifiedById String?                 @db.ObjectId
  verifiedBy   User?                   @relation("PhysicalAuditsConducted", fields: [verifiedById], references: [id], onDelete: SetNull)
  
  auditStatus  AuditVerificationStatus @default(PHYSICAL_OK)
  remarks      String?
  verifiedAt   DateTime                @default(now())
  createdAt    DateTime                @default(now())

  @@index([assetId])
  @@index([verifiedById])
  @@index([auditStatus])
  @@index([verifiedAt])
}

/// Financial and operational audit trail for recurring AirFiber, SIM, and Router recharges
model RechargeHistory {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  assetId         String   @db.ObjectId
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  amount          Float
  validityDays    Int      @default(30)
  rechargeDate    DateTime @default(now())
  newExpiryDate   DateTime
  transactionId   String?   // Transaction ID or Receipt No
  paymentMode     String?  @default("UPI") // UPI, NET_BANKING, CORPORATE_CARD, CASH
  serviceProvider String?  // JIO, AIRTEL, OTHER
  planDetails     String?
  notes           String?
  
  createdById     String?  @db.ObjectId
  createdBy       User?    @relation("RechargesLogged", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assetId])
  @@index([rechargeDate])
  @@index([newExpiryDate])
}
